# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# --- Database (SQLite by default, no setup required) ---
DATABASE_URL=sqlite:///./cybersentinel.db
# For PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cybersentinel

# --- Vector store ---
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- LLM provider ---
# "mock" = free, offline, deterministic rule-based agent reasoning (default).
# "openai_compatible" = a real hosted model you have your own key for.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=mock-security-analyst-v1

# --- Anomaly detection ---
ANOMALY_MODEL_DIR=./ml/artifacts
ANOMALY_CONTAMINATION=0.05

# --- CORS / rate limiting ---
CORS_ALLOW_ORIGINS=["http://localhost:8501","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60
